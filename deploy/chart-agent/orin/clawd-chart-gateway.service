[Unit]
Description=Clawd chart gateway to private Hugging Face Spark
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/clawd-chart/gateway.env
ExecStart=/usr/bin/python3 %h/clawd-chart/gateway.py
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true

[Install]
WantedBy=default.target
